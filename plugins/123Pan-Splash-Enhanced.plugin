#!name=123云盘去广告 · 精简专用版 v6
#!desc=仅清理123云盘的开屏、插屏、横幅及用户广告开关；通用SDK由可莉拦截器和广告平台补充拦截器处理。
#!author=Xitaoyou（增强维护）
#!tag=去广告, 123云盘
#!system=iOS, iPadOS
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Xitaoyou/xixiduo-loon-plugins/blob/main/plugins/123Pan-Splash-Enhanced.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/123NetWorkDisk.png
#!date=2026-11-03

# v6只保留123云盘私有API改写；第三方广告域名和SDK请求已迁到AdPlatform-Supplement.plugin。
# 建议配套：可莉广告平台拦截器 + 广告平台补充拦截器 + 本插件。
# 不拦截登录/上传/下载和会员权益；appConfig/用户响应字段类型沿用旧版已命中写法。
# 奖励广告任务默认保留。不要与本仓库123云盘完整版同时启用。

[Argument]
cleanServerAds = switch,true,tag=关闭开屏和页面广告,desc=开：关闭云盘服务器下发的开屏、插屏、横幅开关；关：保留原始广告设置。
cleanRewardAds = switch,false,tag=隐藏看广告任务（可选）,desc=开：尝试清零广告福利任务次数，可能无法领取奖励；关：保留广告福利任务。

[Rewrite]
# 下面四条是云盘私有API，不负责拦第三方广告SDK。
response if ${cleanServerAds} == true && ${url} ~= /^https:\/\/(?:api\.123278\.com|api\.123panapi\.(?:com|cn))\/api\/config\/get(?:\?|$)/i then response.json.jq("if .code == 0 and (.data | type) == \"object\" then .data |= (.isInitAd = 0 | .isOpenSplash = false | .isOpenAbortAd = false | .isOpenDownloadAd = false | .isOpenMineAd = false | .isOpenUploadAd = false | .interstitialShowCount = 0 | .showCount = 0 | .bannerList = [] | .preloadConfig.iosInter = 0 | .preloadConfig.iosSplash = 0) else . end") | response.header.set("X-123Pan-Loon", "v6-config")
response if ${cleanServerAds} == true && ${url} ~= /^https:\/\/(?:api\.123278\.com|api\.123panapi\.(?:com|cn))\/api\/app\/config\/get(?:\?|$)/i then response.json.jq("if .code == 0 and (.data | type) == \"object\" then .data.isInitAd = 0 else . end") | response.header.set("X-123Pan-Loon", "v6-app")
response if ${cleanServerAds} == true && ${url} ~= /^https:\/\/(?:api\.123278\.com|api\.123panapi\.(?:com|cn))\/api\/user\/info(?:\?|$)/i then response.json.jq("if .code == 0 and (.data | type) == \"object\" then .data.IsShowAdvertisement = false else . end") | response.header.set("X-123Pan-Loon", "v6-user")
response if ${cleanRewardAds} == true && ${url} ~= /^https:\/\/(?:api\.123278\.com|api\.123panapi\.(?:com|cn))\/api\/taku\/ad\/config(?:\?|$)/i then response.json.jq("if .code == 0 and (.data | type) == \"object\" then .data.ad_count = 0 else . end")

[MitM]
hostname=api.123278.com, api.123panapi.com, api.123panapi.cn
