[Rewrite]
response if ${url} ~= /^https:\/\/(?:api\.123278\.com|api\.123panapi\.com)\/api\/(?:config\/get|app\/config\/get|user\/info|v2\/advert_resource\/get)(?:\?|$)/i then script("https://raw.githubusercontent.com/Xitaoyou/xixiduo-loon-plugins/main/scripts/123pan/ad-config.js") with enable=${cleanServerAds}, tag="清理123云盘开屏与页面广告", requires_body=true
response if ${url} ~= /^https:\/\/(?:api\.123278\.com|api\.123panapi\.com)\/api\/taku\/ad\/config(?:\?|$)/i then script("https://raw.githubusercontent.com/Xitaoyou/xixiduo-loon-plugins/main/scripts/123pan/ad-config.js") with enable=${cleanRewardAds}, tag="清理123云盘广告任务", requires_body=true

[MitM]
hostname=api.123278.com, api.123panapi.com
