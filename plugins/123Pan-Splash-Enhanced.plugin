DOMAIN,adsmind.ugdtimg.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao-b.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao1.com,REJECT
DOMAIN,log-api.pangolin-sdk-toutiao.com,REJECT
DOMAIN,log-api.pangolin-sdk-toutiao-b.com,REJECT
DOMAIN,open.e.kuaishou.com,REJECT
DOMAIN,gdfp.gifshow.com,REJECT
DOMAIN,mobads.baidu.com,REJECT
DOMAIN,mobads-logs.baidu.com,REJECT
DOMAIN,wn.pos.baidu.com,REJECT
DOMAIN,als.baidu.com,REJECT
DOMAIN,mobads-pre-config.cdn.bcebos.com,REJECT
DOMAIN,nadvideo2.baidu.com,REJECT
DOMAIN,tk.anythinktech.com,REJECT
DOMAIN,ujoy.anythinktech.com,REJECT
DOMAIN,adx-os.anythinktech.com,REJECT
DOMAIN,t2.fancyapi.com,REJECT
DOMAIN,sdkg.fancyapi.com,REJECT
DOMAIN,sdk-track.66mobi.com,REJECT
DOMAIN,tencent-ssp.66mobi.com,REJECT
