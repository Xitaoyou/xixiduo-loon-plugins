#!name=123云盘去广告 · 抓包增强版
#!desc=根据2026-11-02 iOS抓包升级：清理开屏、插屏、摇一摇广告请求、上传下载页面推广及应用内横幅；保留登录、文件上传下载及会员权益判断。关闭旧版插件避免重复规则。
#!author=Xitaoyou（维护增强）, 可莉（旧版接口参考）
#!tag=去广告, 123云盘
#!system=iOS, iPadOS
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Xitaoyou/xixiduo-loon-plugins/blob/main/plugins/123Pan-Splash-Enhanced.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/123NetWorkDisk.png
#!date=2026-11-02

# 抓包版本：123云盘 iOS 3.3.3。规则按域名全局生效，可能影响其他App的相同广告SDK。
# 不封禁 123pan 主站、123278 / 123panapi API 主机及云盘上传下载服务。
# 不封禁 bdad.123pan.cn（部分用户反馈曾导致下载按钮失效）。

[Argument]
cleanServerAds=switch, true, false, tag=清理开屏、插屏及页面广告（推荐）, desc=开：关闭抓包确认的服务器广告开关、隐藏横幅及推广；关：不修改云盘配置，但广告SDK域名仍被拦截。
cleanRewardAds=switch, false, true, tag=额外清理广告任务配置（可选）, desc=关：保留广告任务数量配置；开：把广告任务数设为0，可能影响看广告领取奖励。

[Rule]
# 专用广告请求主机：包括穿山甲、优量汇、快手、百度、聚合SDK和广告素材。
DOMAIN,sdk.1rtb.net,REJECT
DOMAIN,zlsdk.1rtb.net,REJECT
