#!name=123云盘开屏去广告增强版（实验）
#!desc=可莉旧版只拦截一个配置接口，2026年新增的广告SDK可能不受影响。本版补充1rtb和2026年9月抓包发现的开屏广告SDK；保留旧版横幅广告规则。iOS效果待实测，可能出现数秒广告超时。不会主动屏蔽123云盘主站、文件或下载域名。
#App链接=https://apps.apple.com/app/id1597682672
#!author=Xitaoyou（整合）, 可莉（原始接口规则）
#!tag=去广告, 实验
#!system=iOS, iPadOS
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Xitaoyou/xixiduo-loon-plugins/blob/main/plugins/123Pan-Splash-Enhanced.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/123NetWorkDisk.png
#!date=2026-11-02

# 资料来源：
# - 可莉 123NetWorkDisk_remove_ads.plugin (2026-10-02)：旧版配置接口。
# - ddgksf2013 StartUpAds：sdk.1rtb.net/sdk/req_ad（曾作为123pan开屏规则）。
# - TG-Twilight/AWAvenue-Ads-Rule issue #216 (2026-09-20)：
#   安卓123网盘真实抓包确认的开屏、首页广告SDK；iOS是否相同待验证。
# - zlsdk.1rtb.net：1rtb 系广告SDK另一个已知请求主机。
# 注意：以下 DOMAIN 规则按域名全局生效，也可能影响其他使用同一广告SDK的App。
# 不拦截 bdad.123pan.cn：社区有屏蔽后导致下载按钮失效的记录。
# 不拦截 123pan.com 主站、登录、文件及下载相关域名。

[Rule]
# 123pan关联的1rtb广告请求
DOMAIN,sdk.1rtb.net,REJECT
DOMAIN,zlsdk.1rtb.net,REJECT

# 2026-09 安卓123网盘开屏/首页抓包：广告请求与聚合平台
DOMAIN,sdk.adhuanxiao.com,REJECT
DOMAIN,mpcfg.fancydsp.com,REJECT
DOMAIN,sdk.zhangyuyidong.cn,REJECT
DOMAIN,adm.zhangyuyidong.cn,REJECT
DOMAIN,api.shanghailingye.cn,REJECT
DOMAIN,sdk.hzzfcm.com,REJECT
DOMAIN,jp.ad.gameley.com,REJECT
DOMAIN,de.ad.gameley.com,REJECT
DOMAIN,xadsmartget.adgain.cn,REJECT
DOMAIN,adsmartget.datads.cn,REJECT

[Rewrite]
# 兼容可莉原版配置接口规则，仅限此路径
request if ${url} ~= /^https:\/\/www\.123pan\.com\/api\/config\/get(?:\?|$)/i then reject_dict(200)

[MitM]
hostname=www.123pan.com
