#!name = SideStore IPv6 按需兼容开关
#!icon = https://raw.githubusercontent.com/Xitaoyou/xixiduo-loon-plugins/main/icons/sidestore.png
#!desc = SideStore 0.7+ 刷新时启用；启用期间关闭 Loon TUN IPv6 VIF，刷新后请停用。需要 Build 1007+。
#!author = 西西多
#!date = 2026-11-12
#!tag = SideStore,工具

# 仅用于 SideStore 0.7+ 的 utun 接口筛选兼容。
# 操作：刷新前启用此插件，刷新完成后停用。
# 注意：ipv6-vif 是 Loon TUN 的全局设置，并非只作用于 SideStore 流量。
# 插件停用后，若没有其他已启用插件声明 ipv6-vif = off，则恢复主配置的 IPv6 VIF 模式。

[General]
ipv6-vif = off
