#!name = SideStore 刷新助手
#!desc = Loon 本地回环兼容版 v2：兼容常见 SideStore 设备地址；需要 Build 1007+
#!author = 西西多
#!date = 2026-11-08
#!tag = SideStore,工具

# 使用条件：
# 1. Loon Build 1007+，启用本插件后，断开并重新连接 Loon VPN 让 TUN 路由生效。
# 2. SideStore 的 Connection Config 中设备端点应匹配实际使用的地址。
# 3. 如果出现 DeviceEndpointNotInitialized，请在 SideStore > Settings >
#    Experimental Features > Network Discovery > Local 查看带绿勾的
#    _remotepairing._tcp. 的 IPv4 端口，填写至 Connection Config 的
#    RemotePairPort；端口可能改变，此插件不能替 SideStore 自动发现端口。
# 4. 同时不要运行 LocalDevVPN / WireGuard 的同类隧道。
#
# 仅接管以下两个精确 IPv4 目标，不改 DNS、代理策略、MitM 或 IPv6。
# 10.7.0.1 是 SideStore 常见设备端点；10.7.0.0 仅供旧版/特殊配置兼容。
# 如果使用其他自定义设备端点，须同步调整 include-tun 与 IP Rewrite。
# 注意：此插件无法修复 SideStore 自身的配对文件或设备端点初始化故障。

[General]
include-tun = 10.7.0.1/32,10.7.0.0/32

[IP Rewrite]
10.7.0.1 = reflect
10.7.0.0 = reflect
