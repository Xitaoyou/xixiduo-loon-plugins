#!name = SideStore 刷新助手
#!icon = https://raw.githubusercontent.com/Xitaoyou/xixiduo-loon-plugins/main/icons/sidestore.png
#!desc = SideStore 本地回环；新版 SideStore 刷新时需另启 IPv6 兼容开关。需要 Loon Build 1007+。
#!author = 西西多
#!date = 2026-11-12
#!tag = SideStore,工具

# 使用说明：
# 1. 此基础插件保持启用，提供 SideStore 本机回环路由与 IP Rewrite。
# 2. SideStore 0.7+ 刷新前，另启「SideStore IPv6 按需兼容开关」插件；刷新完成后停用它。
# 3. 按需开关停用后，Loon 恢复主配置的 IPv6 VIF 设置（若无其他插件声明 off）。
# 4. 需要 Loon Build 1007+。若 Peer IP 出现但 TCP 探测失败，再检查 RemotePairing 动态端口。
# 5. 关闭 LocalDevVPN / WireGuard 等其他 VPN 隧道。常见 SideStore 设备端点为 10.7.0.1。
# 本插件不关闭 IPv6、不固定 RemotePairing 端口，也不修改配对文件或签名行为。
[General]
include-tun = 10.7.0.1/32,10.7.0.0/32

[IP Rewrite]
10.7.0.1 = reflect
10.7.0.0 = reflect
