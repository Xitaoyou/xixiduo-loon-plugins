#!name=芒果TV去广告 · 开屏摇一摇增强版
#!desc=依据iOS 9.4.6抓包，清理开屏、摇一摇跳转、视频贴片、页面横幅；优先返回空广告数据，不阻断视频播放与账号接口。
#!author=Xitaoyou（增强维护）, 可莉（旧版规则参考）
#!tag=去广告, 芒果TV
#!system=iOS, iPadOS
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Xitaoyou/xixiduo-loon-plugins/blob/main/plugins/MangoTV-Enhanced.plugin
#!icon=https://raw.githubusercontent.com/Moli-X/Tool/X/Icon/App/Pixel120/Mango_TV.png
#!date=2026-11-02

# 根据芒果TV iOS 9.4.6抓包（288次请求）制作；不是可莉官方更新。
# 不封禁视频源（mobile-stream.api.mgtv.com）、播放鉴权、账号及正常图片CDN。
# 禁用可莉旧版芒果TV插件，避免重复改写；原有可莉广告平台拦截器可以保留。

[Argument]
blockSplash=switch, true, false, tag=清理开屏与摇一摇广告（推荐）, desc=开：让开屏广告接口返回空结果，减少摇一摇跳转App Store；关：保留原生开屏广告。
blockVideoAds=switch, true, false, tag=清理视频贴片广告（推荐）, desc=开：向播放器返回空广告VAST；关：保留视频前贴片广告。
cleanAdConfig=switch, true, false, tag=关闭广告SDK及预加载（推荐）, desc=开：关闭广告SDK开关与开屏预载；关：使用应用原始广告配置。
cleanPageAds=switch, true, false, tag=清理页面推广（可选）, desc=开：过滤“我的”页横幅与已识别的首页推广；关：保留原页面内容。
blockExtraSDK=switch, true, false, tag=补充拦截第三方广告SDK（推荐）, desc=开：阻止抓包中返回广告配置的聚合SDK；关：依赖现有通用广告拦截器。

[Rewrite]
# 开屏广告的JSON响应明确带有 ad_type=boot、互动跳转及广告素材。只改写广告结果。
response if ${blockSplash} == true && ${url} ~= /^https?:\/\/mobile\.da\.mgtv\.com\/json\/app\/bdboot(?:\?|$)/i then response.json.jq("if (.data | type) == \"object\" and .data.ad_type == \"boot\" then .data = {} | .success = \"0\" | .err_code = 204 | .roll_time = 0 | .play_time = 0 else . end")
# 使用抓包中服务器实际返回过的空VAST，避免广告SDK因错误状态不断重试。
response if ${blockSplash} == true && ${url} ~= /^https?:\/\/mobile\.da\.mgtv\.com\/(?:m\/(?:page|bdpage)|channel\/rprain)(?:\?|$)/i then response.body.mock("text", `<VAST version="3.0"><Extensions><Ads></Ads><OttTrackingEvents></OttTrackingEvents><OttQrcodeUrl></OttQrcodeUrl><OttSkipInterface></OttSkipInterface><OttSkipParam></OttSkipParam></Extensions></VAST>`, 200) | response.header.set("Content-Type", "application/xml; charset=utf-8")
response if ${blockVideoAds} == true && ${url} ~= /^https?:\/\/mobile\.da\.mgtv\.com\/app\/player(?:\?|$)/i then response.body.mock("text", `<VAST version="3.0"><Extensions><Ads></Ads><OttTrackingEvents></OttTrackingEvents><OttQrcodeUrl></OttQrcodeUrl><OttSkipInterface></OttSkipInterface><OttSkipParam></OttSkipParam></Extensions></VAST>`, 200) | response.header.set("Content-Type", "application/xml; charset=utf-8")
# 仅清空广告创意清单及已识别的广告素材，不拦正常图片或视频媒体CDN。
request if ${blockSplash} == true && ${url} ~= /^https?:\/\/mobile\.da\.mgtv\.com\/creative\/list(?:\?|$)/i then reject_array(200)
request if ${blockSplash} == true && ${url} ~= /^https?:\/\/img\.da\.mgtv\.com\/mediafiles\/wiad_creative\/.*\.(?:jpe?g|png|webp)(?:\?|$)/i then reject_img(200)
request if ${blockSplash} == true && ${url} ~= /^https?:\/\/img\.da\.mgtv\.com\/(?:mediafiles\/wiad_creative|html5\/newstyle)\/.*\.zip(?:\?|$)/i then reject(204)
# 新版广告SDK配置与应用配置。
response if ${cleanAdConfig} == true && ${url} ~= /^https?:\/\/mobile\.da\.mgtv\.com\/sdk\/config(?:\?|$)/i then response.json.jq("if type == \"object\" then .warm_boot = 0 | .toutiao = 0 | .ylh = 0 | .beizi = 0 | .ubix = 0 | .gdt = 0 | .paster_preload = 0 | .c2s_preload = 0 else . end")
response if ${cleanAdConfig} == true && ${url} ~= /^https?:\/\/mobile\.api\.mgtv\.com\/mobile\/getConfig(?:\?|$)/i then response.json.jq("if (.data | type) == \"object\" then .data |= (if (.adModule | type) == \"object\" then .adModule |= (.useADSdk = 0 | .videoPPStatus = 0 | .isADCache = 0) else . end | if (.adProxy | type) == \"object\" then .adProxy.status = 0 else . end) else . end")
response if ${cleanAdConfig} == true && ${url} ~= /^https?:\/\/mobile\.api\.mgtv\.com\/mobile\/config(?:\?|$)/i then response.json.jq("if (.data | type) == \"object\" then .data |= (if has(\"dc_adConfig\") then .dc_adConfig = \"0\" else . end | if has(\"relative_ads\") then .relative_ads = \"0\" else . end | if has(\"progress_bar_ad_switch\") then .progress_bar_ad_switch = \"0\" else . end | if has(\"playview_box_ad_switch\") then .playview_box_ad_switch = \"0\" else . end) else . end")
# 新版“我的”模块和首页推广；仅去掉明确的广告模块。
response if ${cleanPageAds} == true && ${url} ~= /^https?:\/\/me\.bz\.mgtv\.com\/v4\/module\/list(?:\?|$)/i then response.json.jq("if (.data.list | type) == \"array\" then .data.list |= map(select(.moduleType != 6)) else . end")
response if ${cleanPageAds} == true && ${url} ~= /^https?:\/\/dc\.bz\.mgtv\.com\/dynamic\/v1\/channel\/index\//i then response.json.jq("(if has(\"adInfo\") then del(.adInfo) else . end) | (if (.data | type) == \"array\" then .data |= map(select(.moduleEntityId != \"842\" and .moduleEntityId != \"2237\" and .moduleEntityId != \"5418\")) else . end)")
# 限定为抓包确认的第三方广告配置接口，不封禁相应平台的其他功能。
request if ${blockExtraSDK} == true && ${url} ~= /^https?:\/\/(?:sdkconf\.hs\.lingjuad\.com\/sdk_config\/v3\/config|adx-cfg-u1\.ubixioe\.com\/mob\/sdk\/v3\/init)(?:\?|$)/i then reject(204)

[MitM]
hostname=mobile.da.mgtv.com, img.da.mgtv.com, mobile.api.mgtv.com, me.bz.mgtv.com, dc.bz.mgtv.com, sdkconf.hs.lingjuad.com, adx-cfg-u1.ubixioe.com
