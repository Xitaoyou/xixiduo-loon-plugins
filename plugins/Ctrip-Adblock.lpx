#!name = 携程旅行 · 精准去广告
#!desc = 拦截携程指定广告域名和接口；接口拦截需要 MitM。
#!author = Custom Loon rules
#!icon = https://raw.githubusercontent.com/Xitaoyou/xixiduo-loon-plugins/main/icons/ctrip.png
#!date = 2026-10-31
#!tag = 广告拦截,携程
#!type = normal

# Target only a dedicated ad domain. Keep Ctrip image/CDN/gateway domains accessible.
[Rule]
DOMAIN,ma-adx.ctrip.com,REJECT

# Existing public rules show three tripAds endpoint patterns:
# /restapi/soa2/13916/tripAds, /json/tripAds, /scjson/tripAds.
# These patterns require MitM, with only m.ctrip.com as hostname.
[Rewrite]
request if ${url} ~= /^https:\/\/m\.ctrip\.com\/restapi\/soa2\/\d+\/(?:(?:json|scjson)\/)?tripAds(?:[\/?]|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m\.ctrip\.com\/restapi\/soa2\/\d+\/json\/getAdsList(?:[\/?]|$)/i then reject(200)

[Mitm]
hostname = m.ctrip.com
