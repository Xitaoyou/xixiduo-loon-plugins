#!name = 常用服务检测
#!desc = 参考 FlClash 检测 GitHub、AI 和流媒体的连通与地区状态；仅手动运行，不后台轮询。
#!author = 西西多；FlClash contributors（检测规则来源）
#!homepage = https://github.com/Xitaoyou/xixiduo-loon-plugins
#!date = 2026-11-09
#!loon_version = 3.5.1(983)

[Argument]
profile = select,"core","all",tag=检测范围,desc=core 检测 GitHub、ChatGPT、Claude、Gemini；all 检测全部 13 项服务。
route = input,"current",tag=检测路径,desc=current 按当前规则；DIRECT 强制直连；也可填有效节点或策略组名。
requestTimeout = input,10000,type=number,tag=请求超时（毫秒）,desc=3000–15000，默认10000。

[Script]
generic then script("https://raw.githubusercontent.com/Xitaoyou/xixiduo-loon-plugins/main/scripts/service-check/service-check.js", {${profile}, ${route}, ${requestTimeout}}) with tag="检测常用服务", timeout=120
