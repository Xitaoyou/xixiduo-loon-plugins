#!name=一木记账 VIP · 永久会员（2.6.2 已验证）
#!desc=一木记账 VIP 会员状态改写：设置永久会员 vipType=2、会员有效期至 2099 年；iOS 2.6.2 用户实测可用。仅修改客户端会员信息，云端服务不保证。
#!author=ddm1023（原始脚本） / Xitaoyou（Loon 插件整合）
#!icon=https://raw.githubusercontent.com/deezertidal/private/main/icons/ymjz.png
#!homepage=https://github.com/Xitaoyou/xixiduo-loon-plugins/blob/main/plugins/Yimu_Bookkeeping_Loon_2.6.0.plugin
#!date=2026-11-25

# 功能：拦截一木记账 getUserInfoById 会员信息响应，将 vipType 改为 2（永久会员），vipTime 改为 4092599349000（2099 年）。
# 兼容性：一木记账 iOS 2.6.2 已获用户实测可用反馈；其他版本需自行测试。
# 使用条件：先登录一木记账；在 Loon 中启用本插件、脚本及 MITM，并信任相关证书。
# 限制：只改写客户端收到的会员状态，不保证云同步等服务端付费权益。
# 上游原始 JS：https://raw.githubusercontent.com/chxm1023/Rewrite/main/yimujizhang.js

[Script]
http-response ^https?:\/\/yimuapp\.com:8082\/bookkeeping\/user\/getUserInfoById script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/yimujizhang.js, requires-body=true, timeout=60, tag=一木记账VIP

[MITM]
hostname = yimuapp.com
