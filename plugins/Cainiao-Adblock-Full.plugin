#!name=菜鸟去广告 · 联动完整版 v3
#!desc=修复全局直连漏拦问题，增强开屏与首页广告模块净化；必须搭配可莉广告平台和本仓库补充拦截器v3。
#!author=Xitaoyou
#!tag=去广告,菜鸟,开屏,首页净化
#!system=iOS, iPadOS
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Xitaoyou/xixiduo-loon-plugins/blob/main/plugins/Cainiao-Adblock-Full.plugin
#!date=2026-11-03

# 必须同时启用：可莉广告平台拦截器（BlockAdvertisers） + 本仓库 AdPlatform-Supplement.plugin v3。
# 可按需启用可莉的 HTTPDNS 插件；此菜鸟完整版不复制通用广告SDK域名规则。
# 请关闭可莉 Cainiao_remove_ads.lpx 与旧 Cainiao-Splash-Enhanced.plugin，避免重复复写。
# [Rule] 保留2条菜鸟域名；v3增加缺失的MTop MitM主机，修复首页广告嵌套结构。
# 严禁封禁整个 acs.m.taobao.com、msgacs.m.taobao.com、cn-acs.m.cainiao.com、ossgw.alicdn.com 或 a1.alibabausercontent.com。
# 数据边界：2026-11-03 抓包证实第三方广告 SDK、创意素材；首页商品/楼层接口参考公开规则路径，尚未得到此App版本的对应响应体。
# HAR根因：208/210请求命中GLOBAL,DIRECT；必须切回Loon「规则分流」才能使用广告域名REJECT。
# 首页复写覆盖真实嵌套的data.result.dataList、data.data.data.operationList和指定商品广告位。
# 只修改经授权的本仓库文件；不复制或再发行可莉源码。

[Argument]
blockSplash = switch,true,false,tag=精准拦截开屏图片与视频,desc=开：拦截本次抓包出现的开屏创意路径；需MitM。关：关闭素材级拦截；配套的通用广告域名拦截仍按独立插件运行。
blockHomeAds = switch,true,false,tag=隐藏首页商品推广,desc=开：广告专用接口返回404，避免假的HTTP200导致空广告框；需MitM。
cleanHomeModules = switch,true,false,tag=清除首页广告窗口与信息流,desc=开：过滤营销模块、广告位和嵌套operationList，保留物流列表。
cleanMine = switch,false,true,tag=精简我的页面推广（可选）,desc=默认关闭；启用后针对我的页面接口过滤明显的广告字段。

[Rule]
# 仅保留本App专用且未由广告平台补充版收录的广告请求域名。
# 其他广告SDK/竞价域名由可莉广告平台拦截器 + 广告平台补充拦截器 v3 负责，不再重复声明。
DOMAIN,adashx.ut.cainiao.com,REJECT
DOMAIN,h-adashx.ut.cainiao.com,REJECT

[Rewrite]
# 必须使用Loon规则分流模式；GLOBAL,DIRECT会跳过普通域名拒绝。
request if ${blockHomeAds} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+(?:\.[a-z0-9-]+)*\.cainiao\.com|(?:cn-)?acs\.m\.taobao\.com|msgacs\.m\.taobao\.com)\/gw\/mtop\.cainiao\.nbcps\.presentation\.fetch\.cn(?:[\/?]|$)/i then reject(404)
request if ${blockHomeAds} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+(?:\.[a-z0-9-]+)*\.cainiao\.com|(?:cn-)?acs\.m\.taobao\.com|msgacs\.m\.taobao\.com)\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(?:index|show|batch\.show\.v2)(?:\.cn)?(?:[\/?]|$)/i then reject(404)
request if ${blockHomeAds} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+(?:\.[a-z0-9-]+)*\.cainiao\.com|(?:cn-)?acs\.m\.taobao\.com|msgacs\.m\.taobao\.com)\/gw\/mtop\.cainiao\.adkeyword(?:\.get\.cn)?(?:[\/?]|$)/i then reject(404)
request if ${blockHomeAds} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+(?:\.[a-z0-9-]+)*\.cainiao\.com|(?:cn-)?acs\.m\.taobao\.com|msgacs\.m\.taobao\.com)\/gw\/mtop\.cainiao\.nbopen\.miniapp\.recommend\.cpc\.cn(?:[\/?]|$)/i then reject(404)
request if ${blockHomeAds} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+(?:\.[a-z0-9-]+)*\.cainiao\.com|(?:cn-)?acs\.m\.taobao\.com|msgacs\.m\.taobao\.com)\/gw\/mtop\.cainiao\.nbpresentation\.tabbar\.marketing\.get\.cn(?:[\/?]|$)/i then reject(404)
request if ${blockHomeAds} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+(?:\.[a-z0-9-]+)*\.cainiao\.com|(?:cn-)?acs\.m\.taobao\.com|msgacs\.m\.taobao\.com)\/gw\/mtop\.cainiao\.nbmensa\.research\.researchservice\.(?:acquire|event|close)\.cn(?:[\/?]|$)/i then reject(404)
# 开屏素材路径精准拦截，不封共享CDN。
request if ${blockSplash} == true && ${url} ~= /^https:\/\/ossgw\.alicdn\.com\/creatives-assets\/prod\/feupload\/user\/7clgu\/[^?#]+\.(?:jpe?g|png|webp)(?:\?|$)/i then reject(403)
request if ${blockSplash} == true && ${url} ~= /^https:\/\/a1\.alibabausercontent\.com\/prod\/feupload\/user\/7clgu\/[^?#]+\.mp4(?:_\.mp4)?(?:\?|$)/i then reject(403)
# 清除广告模块及占位。
response if ${cleanHomeModules} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+(?:\.[a-z0-9-]+)*\.cainiao\.com|(?:cn-)?acs\.m\.taobao\.com|msgacs\.m\.taobao\.com)\/gw\/mtop\.cainiao\.nbpresentation\.(?:protocol\.homepage|homepage\.merge)\.get\.cn(?:[\/?]|$)/i then response.json.jq("if (.data.result.dataList | type) == \"array\" then .data.result.dataList |= map(select(((.type // \"\") | tostring | ascii_downcase | test(\"banner_area|promotion|advert|marketing|sponsor\")) | not)) else . end | if (.data.data.data | type) == \"object\" then .data.data.data |= del(.mainSearch.bizData.searchContents, .operationList) else . end") | response.header.set("X-Cainiao-Clean", "home-v3")
response if ${cleanHomeModules} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+(?:\.[a-z0-9-]+)*\.cainiao\.com|(?:cn-)?acs\.m\.taobao\.com|msgacs\.m\.taobao\.com)\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch(?:\.cn)?(?:[\/?]|$)/i then response.json.jq("del(.data.data.data.mainSearch.bizData.searchContents, .data.data.data.operationList, .data.data.banner, .data.data.activity)") | response.header.set("X-Cainiao-Clean", "e2e-v3")
response if ${cleanHomeModules} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+(?:\.[a-z0-9-]+)*\.cainiao\.com|(?:cn-)?acs\.m\.taobao\.com|msgacs\.m\.taobao\.com)\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.mshow(?:\.cn)?(?:[\/?]|$)/i then response.json.jq("if (.data | type) == \"object\" then .data |= del(.\"1316\", .\"1332\", .\"1638\", .\"1910\", .\"618\", .\"1524\", .\"1525\") else . end") | response.header.set("X-Cainiao-Clean", "mshow-v3")
response if ${cleanHomeModules} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+(?:\.[a-z0-9-]+)*\.cainiao\.com|(?:cn-)?acs\.m\.taobao\.com|msgacs\.m\.taobao\.com)\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(?:batch\.show\.v2|show)(?:\.cn)?(?:[\/?]|$)/i then response.json.jq("if (.data.result | type) == \"array\" then .data.result |= map(select(((.materialContentMapper.adItemDetail != null) or (.materialContentMapper.advRecGmtModifiedTime != null) or ((.materialContentMapper.group_id // \"\") | IN(\"common_header_banner\", \"entertainment\", \"interests\", \"kuaishou_banner\"))) | not)) else . end") | response.header.set("X-Cainiao-Clean", "ads-v3")
response if ${cleanHomeModules} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+(?:\.[a-z0-9-]+)*\.cainiao\.com|(?:cn-)?acs\.m\.taobao\.com|msgacs\.m\.taobao\.com)\/gw\/mtop\.com\.cainiao\.longquan\.place\.getpageresourcecontent\.cn(?:[\/?]|$)/i then response.json.jq("if (.data.result.placeContentMap[\"780001\"].contentList | type) == \"array\" then del(.data.result.placeContentMap[\"780001\"].contentList) else . end") | response.header.set("X-Cainiao-Clean", "longquan-v3")
response if ${cleanMine} == true && ${url} ~= /^https?:\/\/(?:[a-z0-9-]+(?:\.[a-z0-9-]+)*\.cainiao\.com|(?:cn-)?acs\.m\.taobao\.com|msgacs\.m\.taobao\.com)\/gw\/mtop\.cainiao\.app\.mine\.main(?:\.cn)?(?:[\/?]|$)/i then response.json.jq("if (.data | type) == \"object\" then .data |= del(.adList, .ads, .adBanner, .marketingList, .promotionList, .cpsRecommend, .goodsRecommend, .recommendGoods, .productAds) else . end") | response.header.set("X-Cainiao-Clean", "mine-v3")

[MitM]
hostname=cn-acs.m.cainiao.com, netflow-mtop.cainiao.com, nbcps-mtop.cainiao.com, e2e-mtop.cainiao.com, longquan-mtop.cainiao.com, acs.m.taobao.com, msgacs.m.taobao.com, ossgw.alicdn.com, a1.alibabausercontent.com
