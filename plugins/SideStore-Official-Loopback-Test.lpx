#!name = SideStore 本机回环 · 官方参数对照测试
#!desc = 仅用于排查 SideStore 与 Loon 兼容性；请先关闭原 SideStore 刷新助手。启用期间会关闭 Loon TUN 的 IPv6 VIF。
#!author = 西西多
#!loon_version = 3.5.3(1007)
#!tag = SideStore,诊断

# 使用方式：关闭旧 SideStore-Refresh.lpx 后只启用本测试插件，断开并重新连接 Loon VPN。
# 本文件严格采用 Loon 官方示例的回环参数，不包含其他去广告、DNS、策略或脚本设置。
# 若无效，请停用本测试插件并重连 Loon，IPv6 VIF 将恢复主配置设置（若无其他插件强制 off）。
# 10.7.0.1 是 SideStore 本地设备端点；49152 是 TCP 端口，由 SideStore 自行配置，本插件不会修改端口。

[General]
ipv6-vif = off
include-tun = 10.7.0.1/32

[IP Rewrite]
10.7.0.1 = reflect
