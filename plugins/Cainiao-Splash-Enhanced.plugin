#!name=菜鸟去广告 · 开屏素材与广告SDK精准补丁
#!desc=按2026-11-03菜鸟iOS抓包拦截双11开屏图片/视频及有实际广告响应的第三方SDK接口；避免封禁阿里通用CDN。
#!author=Xitaoyou
#!tag=去广告, 菜鸟, 开屏
#!system=iOS, iPadOS
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Xitaoyou/xixiduo-loon-plugins/blob/main/plugins/Cainiao-Splash-Enhanced.plugin
#!date=2026-11-03

# 独立补丁：与可莉菜鸟去广告、可莉广告平台拦截器和本仓库广告平台补充拦截器共存。
# 实证：ossgw.alicdn.com 传回双11开屏 JPG；a1.alibabausercontent.com 传回同款5秒MP4。
# 实证：v2mi.gdt.qq.com/gdt_mview.fcg 传回携程广告；ssp.iytcdn.com 返回 ad_splash_enable=1。
# sdk.1rtb.net/sdk/req_ad 返回二进制广告请求响应，但内容未解码，作为SDK投放路径补拦。
# 两个 CDN 均承载其他正常资源；只拒绝广告素材路径，不添加整域名 REJECT。
# 第三方SDK的域名规则可能已由可莉覆盖；此处补 HTTP 请求级精准拦截，避免重复全局 DOMAIN 规则。
# 采用 reject(403) 而非 reject_img(200)，不伪装为一次成功的广告素材加载。

[Argument]
blockSplashAssets = switch,true,false,tag=拦截开屏图片与视频,desc=默认开启；只针对抓包证实的广告素材路径及活动资源目录。
blockAdSDK = switch,true,false,tag=拦截广告SDK请求,desc=默认开启；仅拦实测出现的广告接口，不影响菜鸟正常物流查询。

[Rewrite]
# 阿里广告创意专用路径，保留同域下其他图片、静态资源和用户内容。
request if ${blockSplashAssets} == true && ${url} ~= /^https:\/\/ossgw\.alicdn\.com\/creatives-assets\/prod\/feupload\/user\/[^\/?#]+\/[^?#]+\.(?:jpe?g|png|webp)(?:\?|$)/i then reject(403)
# 仅拦已在抓包中证实的天猫双11活动素材目录，不拦 a1.alibabausercontent.com 全域。
request if ${blockSplashAssets} == true && ${url} ~= /^https:\/\/a1\.alibabausercontent\.com\/prod\/feupload\/user\/7clgu\/[^?#]+\.mp4(?:_\.mp4)?(?:\?|$)/i then reject(403)

# 广点通：/gdt_mview.fcg 响应中实际包含携程图文广告与素材链接。
request if ${blockAdSDK} == true && ${url} ~= /^https:\/\/v2mi\.gdt\.qq\.com\/gdt_mview\.fcg(?:\?|$)/i then reject(403)
# 第三方聚合广告：抓包中的 /union/sdk/config 已显式下发广告和开屏广告开关。
request if ${blockAdSDK} == true && ${url} ~= /^https:\/\/ssp\.iytcdn\.com\/union\/sdk\/(?:config|data)(?:\?|$)/i then reject(403)
# MS/1RTB 广告竞价接口；不屏蔽 SDK 全域的普通业务接口。
request if ${blockAdSDK} == true && ${url} ~= /^https:\/\/sdk\.1rtb\.net\/sdk\/req_ad(?:\?|$)/i then reject(403)

[MitM]
hostname=ossgw.alicdn.com, a1.alibabausercontent.com, v2mi.gdt.qq.com, ssp.iytcdn.com, sdk.1rtb.net
