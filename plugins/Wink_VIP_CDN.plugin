#!name=Wink VIP · 会员解锁（CDN 镜像）
#!desc=改写 Wink 的会员接口：is_vip / use_vip / have_valid_contract 置真，有效期拉到 2999 年，子类型与会员组抬到最高档，购买页显示已购；按响应里出现的字段形态判断，不锁死路径，App 换版本换路径也能命中。附只读探测脚本用于跟版。
#!author=Xitaoyou
#!tag=功能增强, 会员
#!system=iOS, iPadOS
#!system_version=15
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Xitaoyou/xixiduo-loon-plugins/blob/main/plugins/Wink_VIP_CDN.plugin
#!date=2026-11-26

# 本文件是 CDN 镜像版：脚本走 jsDelivr（cdn.jsdelivr.net）。raw.githubusercontent.com 拉不动时用这份。
# 说明：Wink 的会员判定同时看服务端和本机 JSON。插件改的是本机读到的响应，
# 视频导出、云端模板、AI 素材是否放行仍由服务端决定，见 docs/Wink-VIP.md 第五节。
# api-sub.meitu.com 是美图全家共用的会员域名，本插件只改会员形态的 JSON，
# 但同一台设备上的美图秀秀也会被顺带命中；要隔离请打开「仅改 Wink 自身请求」。

[Argument]
unlockVip=switch, true, false, tag=会员态解锁, desc=开：把会员接口里的 is_vip、use_vip、have_valid_contract 置真，有效期抬到 farFutureTime，会员子类型与会员组抬到最高档；关：保持服务端原值。
rewritePurchase=switch, true, false, tag=购买页已购态, desc=开：购买页商品列表里的已购标记置真；关：保持原值。只影响购买页展示，不改价格、不造 SKU。
modifyProfile=switch, false, true, tag=资料页会员标识, desc=开：账号资料接口里的 vip_type 与蓝/红 V 状态置真；关：保持原值。只影响展示，默认关闭。
strictAppOnly=switch, false, true, tag=仅改 Wink 自身请求, desc=开：只处理 User-Agent 带 Wink 的请求，同域名下的美图秀秀等其它美图 App 不受影响；关：同域名全部按形态改写。
farFutureTime=input, 32495529599000, tag=到期时间戳（毫秒）, desc=毫秒时间戳，默认 32495529599000（2999 年）。只会往上抬，不会缩短服务端已有的更长有效期；秒级字段自动按秒换算。
probeMode=switch, false, true, tag=接口探测（排障）, desc=开：只记录接口路径与字段骨架并发通知，不改任何响应。App 升级后主插件失效时用它找新字段，平时关闭。
debugMode=switch, false, true, tag=排障日志, desc=开：每次改写弹通知说明改了哪些字段；关：静默运行。

# 规则按域名匹配，脚本内部按响应形态分派；probeMode 打开时改写规则让路，避免探到被改过的响应。

[Script]
response if ${probeMode} == false && ${url} ~= /^https?:\/\/(?:api-sub|api-winkcut)\.meitu\.com\//i then script("https://cdn.jsdelivr.net/gh/Xitaoyou/xixiduo-loon-plugins@main/scripts/wink/vip.js", {${unlockVip}, ${rewritePurchase}, ${modifyProfile}, ${strictAppOnly}, ${farFutureTime}, ${probeMode}, ${debugMode}}) with requires_body=true, debug=${debugMode}, tag="Wink 会员态"

response if ${probeMode} == false && ${url} ~= /^https?:\/\/(?:h5api-winkcut|api\.account)\.meitu\.com\//i then script("https://cdn.jsdelivr.net/gh/Xitaoyou/xixiduo-loon-plugins@main/scripts/wink/vip.js", {${unlockVip}, ${rewritePurchase}, ${modifyProfile}, ${strictAppOnly}, ${farFutureTime}, ${probeMode}, ${debugMode}}) with requires_body=true, debug=${debugMode}, tag="Wink H5·账号"

response if ${probeMode} == true && ${url} ~= /^https?:\/\/(?:api-sub|api-winkcut|h5api-winkcut|api\.account)\.meitu\.com\//i then script("https://cdn.jsdelivr.net/gh/Xitaoyou/xixiduo-loon-plugins@main/scripts/wink/probe.js") with requires_body=true, debug=true, tag="接口探测"

[MitM]
hostname = api-sub.meitu.com, api-winkcut.meitu.com, h5api-winkcut.meitu.com, api.account.meitu.com
